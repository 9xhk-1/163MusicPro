<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- media3 PlayerView casts this view to ImageButton and drives its icon
         via setImageResource, so the widget type cannot become MaterialButton. -->
    <ImageButton
        android:id="@id/exo_play_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_volume_indicator_icon"
        android:backgroundTint="@color/primary_container"
        android:contentDescription="播放"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:tint="@color/on_primary_container" />

    <!-- Top bar lives inside the controller so it hides/shows together
         with the progress bar. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mv_player_back"
            style="@style/Widget.App.PlayerIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:backgroundTint="@android:color/transparent"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="18dp"
            app:iconTint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_mv_player_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/surface_overlay"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="2dp"
            app:buffered_color="@color/surface_variant"
            app:played_color="@color/colorPrimary"
            app:scrubber_color="@color/on_primary_container"
            app:unplayed_color="@color/surface_variant" />
    </LinearLayout>
</FrameLayout>
