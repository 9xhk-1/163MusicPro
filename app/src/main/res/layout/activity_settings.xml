<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:text="@string/settings"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings_toggle"
            style="@style/Widget.App.MenuItem"
            android:text="开关选项"
            app:icon="@drawable/ic_tune" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings_edit_more"
            style="@style/Widget.App.MenuItem"
            android:text="编辑更多页面"
            app:icon="@drawable/ic_dashboard" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings_check_update"
            style="@style/Widget.App.MenuItem"
            android:text="检测更新"
            app:icon="@drawable/ic_refresh" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings_help"
            style="@style/Widget.App.MenuItem"
            android:text="帮助"
            app:icon="@drawable/ic_chat_bubble" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings_about"
            style="@style/Widget.App.MenuItem"
            android:text="关于"
            app:icon="@drawable/ic_info" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings_open_source"
            style="@style/Widget.App.MenuItem"
            android:text="开源信息"
            app:icon="@drawable/ic_code" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings_xtc_module"
            style="@style/Widget.App.MenuItem"
            android:text="小天才模块"
            app:icon="@drawable/ic_get_app" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings_background"
            style="@style/Widget.App.MenuItem"
            android:text="自定义背景"
            app:icon="@drawable/ic_image" />
    </LinearLayout>
</ScrollView>
