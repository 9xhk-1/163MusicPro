<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:text="@string/more"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_favorites"
            style="@style/Widget.App.MenuItem"
            android:text="收藏列表"
            app:icon="@drawable/ic_favorite_border" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_my_playlists"
            style="@style/Widget.App.MenuItem"
            android:text="我的歌单"
            android:visibility="gone"
            app:icon="@drawable/ic_queue_music" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_daily_recommend"
            style="@style/Widget.App.MenuItem"
            android:text="每日推荐"
            android:visibility="gone"
            app:icon="@drawable/ic_today" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_radar_playlist"
            style="@style/Widget.App.MenuItem"
            android:text="雷达歌单"
            android:visibility="gone"
            app:icon="@drawable/ic_radar" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_music_cloud"
            style="@style/Widget.App.MenuItem"
            android:text="音乐云盘"
            android:visibility="gone"
            app:icon="@drawable/ic_cloud" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_search"
            style="@style/Widget.App.MenuItem"
            android:text="搜索"
            app:icon="@drawable/ic_search" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_song_recognition"
            style="@style/Widget.App.MenuItem"
            android:text="听歌识曲"
            app:icon="@drawable/ic_audio_search" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_downloads"
            style="@style/Widget.App.MenuItem"
            android:text="下载列表"
            app:icon="@drawable/ic_get_app" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_ringtones"
            style="@style/Widget.App.MenuItem"
            android:text="铃声管理"
            app:icon="@drawable/ic_notifications" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_toplist"
            style="@style/Widget.App.MenuItem"
            android:text="排行榜"
            app:icon="@drawable/ic_leaderboard" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_history"
            style="@style/Widget.App.MenuItem"
            android:text="历史记录"
            app:icon="@drawable/ic_history" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_profile"
            style="@style/Widget.App.MenuItem"
            android:text="个人中心"
            android:visibility="gone"
            app:icon="@drawable/ic_person" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_personal_fm"
            style="@style/Widget.App.MenuItem"
            android:text="私人漫游"
            android:visibility="gone"
            app:icon="@drawable/ic_music_note" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_login"
            style="@style/Widget.App.MenuItem"
            android:text="登录"
            app:icon="@drawable/ic_vpn_key" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu_settings"
            style="@style/Widget.App.MenuItem"
            android:text="设置"
            app:icon="@drawable/ic_settings" />
    </LinearLayout>
</ScrollView>
