<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tighten Material alert dialog chrome for the 160x180dp watch: the
         library defaults (18dp title padding, 16dp title gap, 24dp button-bar
         padding) crowd out the message and list content in the ~132dp-tall
         dialog window. Names come from the material/appcompat layouts. -->
    <dimen name="abc_dialog_padding_top_material">10dp</dimen>
    <dimen name="m3_alert_dialog_title_bottom_margin">4dp</dimen>
    <dimen name="m3_alert_dialog_action_top_padding">8dp</dimen>
    <dimen name="m3_alert_dialog_action_bottom_padding">8dp</dimen>
</resources>
