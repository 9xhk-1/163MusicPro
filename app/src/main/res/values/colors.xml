<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 苹果风格深色：中性灰白 + 半透明玻璃层，全表无紫色。
         Android 10 没有系统级 blur API，这里用「低不透明度填充 + 发丝描边 +
         顶部高光渐变」模拟毛玻璃，纯 XML、零内存开销，适配 0.78GB 手表。 -->

    <!-- M3 语义主色（组件仍会读这些 attr，改成中性色即可全局去紫） -->
    <color name="colorPrimary">#F2F2F7</color>
    <color name="colorPrimaryDark">#000000</color>
    <color name="colorAccent">#F2F2F7</color>
    <color name="colorTertiary">#AEAEB2</color>
    <color name="colorTertiaryContainer">#1C1C1E</color>
    <color name="colorOnTertiaryContainer">#F2F2F7</color>
    <color name="colorError">#FF6B6B</color>
    <color name="colorErrorContainer">#4A1A1C</color>
    <color name="on_primary">#1C1C1E</color>
    <color name="primary_container">#2E2E30</color>
    <color name="on_primary_container">#FFFFFFFF</color>
    <color name="surface_variant">#33FFFFFF</color>

    <!-- 玻璃材质层 -->
    <color name="glass_fill">#26FFFFFF</color>
    <color name="glass_fill_strong">#40FFFFFF</color>
    <color name="glass_stroke">#3DFFFFFF</color>
    <color name="glass_ripple">#1AFFFFFF</color>
    <color name="glass_scrim">#99000000</color>
    <color name="glass_panel">#D91C1C1E</color>
    <color name="glass_dialog_fill">#E61C1C1E</color>
    <color name="accent_ios">#0A84FF</color>

    <!-- Surface / Background -->
    <color name="bg_dark">#000000</color>
    <color name="surface">#141416</color>
    <color name="surface_elevated">#26FFFFFF</color>
    <color name="surface_overlay">#99000000</color>

    <!-- Text -->
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#AEAEB2</color>
    <color name="text_disabled">#61FFFFFF</color>
    <color name="text_hint">#80FFFFFF</color>

    <!-- Divider / Outline -->
    <color name="divider">#1FFFFFFF</color>
    <color name="outline">#33FFFFFF</color>

    <!-- Icon tints -->
    <color name="icon_active">#FFFFFFFF</color>
    <color name="icon_inactive">#80FFFFFF</color>

    <!-- Compatibility aliases -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="gray_light">#80FFFFFF</color>
    <color name="gray_text">#B3FFFFFF</color>
    <color name="qr_background">#FFFFFFFF</color>
    <color name="favorite_red">#FF453A</color>

    <!-- 覆盖 Material3 库自带的紫/粉调色板：app 资源优先于库资源，
         这样即使某个 M3 组件内部直接引用 palette，也不会漏出紫色。 -->
    <color name="m3_ref_palette_primary0">#FF000000</color>
    <color name="m3_ref_palette_primary10">#FF1C1C1E</color>
