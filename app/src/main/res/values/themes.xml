<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 苹果风格深色主题：M3 组件只当骨架用，视觉交给半透明玻璃层。
         所有按钮不再用紫色 tonal 填充，改成低不透明度玻璃 + 发丝描边。 -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/glass_fill</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorError">@color/colorError</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <!-- 中性涟漪，取代原来的紫色 #33D0BCFF -->
        <item name="android:colorControlHighlight">@color/glass_ripple</item>
        <!-- Dialog chrome must stay compact: the watch dialog window is only
             ~132dp tall, so default M3 title/button bar sizes crowd out the
             message or list content. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
    </style>

    <!-- MainActivity theme: disables system swipe-to-dismiss -->
    <style name="AppTheme.Main" parent="AppTheme">
        <item name="android:windowSwipeToDismiss">false</item>
    </style>

    <!-- 玻璃主按钮：半透明填充 + 发丝描边 + 白字 -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/glass_fill_strong</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- 描边按钮 -->
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- 纯文字按钮 -->
    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 输入框也走玻璃层 -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/glass_fill</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintEnabled">false</item>
    </style>

    <!-- Rounded corners for cover art and avatars. -->
    <style name="ShapeAppearance.App.ImageRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Widget.App.ShapeImage" parent="">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.ImageRounded</item>
    </style>

    <!-- 手表菜单项：玻璃卡片 + 白图标白字，不再是紫色 tonal 块 -->
    <style name="Widget.App.MenuItem" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/glass_fill</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconTint">@color/icon_active</item>
        <item name="iconGravity">start</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">10dp</item>
    </style>

    <!-- 播放页图标按钮：透明玻璃圆角方块 + 白色图标 -->
    <style name="Widget.App.PlayerIcon" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">@color/glass_fill</item>
        <item name="iconTint">@color/icon_active</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">0dp</item>
    </style>

    <!-- 播放/暂停键略亮一档，其余与 PlayerIcon 一致 -->
    <style name="Widget.App.PlayerIcon.Primary" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">@color/glass_fill_strong</item>
        <item name="iconTint">@color/icon_active</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">0dp</item>
    </style>

    <!-- Compact Material 3 alert dialog chrome for the 160x180dp display:
         default title/button-bar sizes leave no room for the message or list
         content in the ~132dp-tall dialog window. windowIsFloating is
         required because the overlay wraps the activity theme, whose
         non-floating window would otherwise stretch the dialog background
         across the whole screen with content stuck to the top. -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowIsFloating">true</item>
        <item name="colorSurface">@color/glass_dialog_fill</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.App</item>
        <item name="dialogPreferredPadding">12dp</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.App.Title.Text</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.App.Body.Text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.DialogButton.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.DialogButton.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.App.DialogButton.Text</item>
    </style>

    <style name="MaterialAlertDialog.App" parent="MaterialAlertDialog.Material3">
        <item name="backgroundInsetStart">12dp</item>
        <item name="backgroundInsetTop">12dp</item>
        <item name="backgroundInsetEnd">12dp</item>
        <item name="backgroundInsetBottom">12dp</item>
    </style>

    <style name="MaterialAlertDialog.App.Title.Text" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="MaterialAlertDialog.App.Body.Text" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Widget.App.DialogButton.Text" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
